{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seattle-trash-calendar",
  "account_id": "e8f7987244b0746942aebda85e5d5c71",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/adapters/worker.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "LOOKUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
